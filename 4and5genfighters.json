{
  "taxonomy": {
    "domain": "Kampfflieger / Combat Fighters",
    "precise_delimitation": "Aktuelle und kürzlich produzierte Luftüberlegenheits- und Multirole-Kampfflugzeuge der 4. und 5. Generation (plus ausgewählte 4.5-Gen). Keine Trainer, keine reinen Bomber, keine reinen Aufklärer (z.B. SR-71), keine reinen Interceptoren älterer Generationen außer dem MiG-31BM als bewusster Ausreißer. Fokus auf in Dienst stehende oder kurz vor Einführung stehende Typen, bei denen Kenntnis der Eigenschaften spielentscheidend ist.",
    "game_type": "Top Ass (Top Trumps / Supertrumpf Variante)",
    "player_count": "2–4",
    "mechanics": {
      "stack": "Verdeckte Stapel, nur oberste Karte sichtbar",
      "turn": "Spieler wählt eine Kategorie und die Richtung (höher oder kleiner)",
      "comparison": "Alle offenen Karten werden verglichen; der beste Wert gewinnt alle Karten und legt sie unter seinen Stapel",
      "win_condition": "Alle Karten besitzen",
      "knowledge_requirement": "Spieler müssen die relativen Stärken im gesamten 32er-Pool kennen (ähnlich Card Counting)"
    },
    "criteria": [
      {
        "id": "speed",
        "name": "Höchstgeschwindigkeit",
        "unit": "km/h",
        "direction_default": "higher",
        "description": "Maximale Geschwindigkeit in der Höhe"
      },
      {
        "id": "thrust_hubkraft",
        "name": "Schub (Hubkraft)",
        "unit": "kg",
        "direction_default": "higher",
        "description": "Gesamtschub mit Nachbrenner umgerechnet in äquivalente Hubkraft (1 kN ≈ 102 kg). Direkt mit Gewicht vergleichbar."
      },
      {
        "id": "ceiling",
        "name": "Gipfelhöhe",
        "unit": "m",
        "direction_default": "higher",
        "description": "Dienstgipfelhöhe"
      },
      {
        "id": "empty_weight",
        "name": "Leergewicht",
        "unit": "kg",
        "direction_default": "lower",
        "description": "Leergewicht. Spieler können explizit 'kleiner' wählen."
      },
      {
        "id": "range",
        "name": "Kampfradius",
        "unit": "km",
        "direction_default": "higher",
        "description": "Typischer Kampfradius mit interner Treibstoffladung"
      },
      {
        "id": "climb",
        "name": "Steigrate",
        "unit": "m/s",
        "direction_default": "higher",
        "description": "Maximale Steigrate"
      },
      {
        "id": "tw_ratio",
        "name": "Thrust-to-Weight",
        "unit": "ratio",
        "direction_default": "higher",
        "description": "Schub-Gewichts-Verhältnis (mit Nachbrenner, typische Konfiguration)"
      },
      {
        "id": "payload",
        "name": "Max. Waffenzuladung",
        "unit": "kg",
        "direction_default": "higher",
        "description": "Maximale externe/interne Ordnance-Zuladung"
      }
    ]
  },
  "balance_notes": {
    "philosophy": "RPSLS-ähnliche Ausgewogenheit anstreben: Kein Flieger soll in allen Kategorien dominieren oder verlieren. Trade-offs sind erwünscht (z.B. leicht + hoher T/W vs. schwer + hohe Zuladung).",
    "known_extremes": {
      "speed_ceiling_dominator": "MiG-31BM",
      "payload_dominator": "F-15EX",
      "light_agile": [
        "Gripen E",
        "Tejas",
        "JF-17",
        "Mirage 2000-5"
      ],
      "heavy_bombers_trucks": [
        "F-15EX",
        "J-20",
        "Su-35S",
        "J-16"
      ]
    },
    "win_loss_summary": "Mit 8 Kategorien und den neuen Trade-offs (Climb, T/W, Payload, Hubkraft) ist die Verteilung deutlich ausgewogener als das ursprüngliche 5-Kategorien-Set. Leichte Flieger gewinnen klar bei Gewicht und oft bei T/W/Climb; schwere Flieger bei Payload, Schub und teilweise Reichweite."
  },
