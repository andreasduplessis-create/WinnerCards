      },
      {
        "id": "ceiling",
        "name": "Gipfelhöhe",
        "unit": "m",
        "direction_default": "higher",
        "description": "Dienstgipfelhöhe"
      },
      {
        "id": "empty_weight",
        "name": "Leergewicht",
        "unit": "kg",
        "direction_default": "lower",
        "description": "Leergewicht. Spieler können explizit 'kleiner' wählen."
      },
      {
        "id": "range",
        "name": "Kampfradius",
        "unit": "km",
        "direction_default": "higher",
        "description": "Typischer Kampfradius mit interner Treibstoffladung"
      },
      {
        "id": "climb",
        "name": "Steigrate",
        "unit": "m/s",
        "direction_default": "higher",
        "description": "Maximale Steigrate"
      },
      {
        "id": "tw_ratio",
        "name": "Thrust-to-Weight",
        "unit": "ratio",
        "direction_default": "higher",
        "description": "Schub-Gewichts-Verhältnis (mit Nachbrenner, typische Konfiguration)"
      },
      {
        "id": "payload",
        "name": "Max. Waffenzuladung",
        "unit": "kg",
        "direction_default": "higher",
        "description": "Maximale externe/interne Ordnance-Zuladung"
      }
    ]
  },
  "balance_notes": {
    "philosophy": "RPSLS-ähnliche Ausgewogenheit anstreben: Kein Flieger soll in allen Kategorien dominieren oder verlieren. Trade-offs sind erwünscht (z.B. leicht + hoher T/W vs. schwer + hohe Zuladung).",
    "known_extremes": {
      "speed_ceiling_dominator": "MiG-31BM",
